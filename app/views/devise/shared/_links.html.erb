<div class="auth__links">
  <% if controller_name != "sessions" %>
    <%= link_to t("ui.links.sign_in"), new_session_path(resource_name) %>
  <% end %>
  <% if devise_mapping.registerable? && Rails.configuration.x.registration_open && controller_name != "registrations" %>
    <%= link_to t("ui.links.sign_up"), new_registration_path(resource_name) %>
  <% end %>
  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to t("ui.links.forgot_password"), new_password_path(resource_name) %>
  <% end %>
</div>
