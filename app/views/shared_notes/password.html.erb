<% content_for :title, t("ui.share.locked_title") %>
<div class="sticky sticky--yellow auth">
  <div class="sticky__bar"><span class="sticky__caption"><%= t("ui.share.shared_note") %></span></div>
  <div class="auth__body">
    <h2><%= icon :lock %> <%= t("ui.share.locked_title") %></h2>
    <p class="auth__hint"><%= t("ui.share.locked_hint") %></p>
    <%= form_with url: unlock_shared_note_path(@note.share_token), id: "unlock_form" do %>
      <div class="field">
        <%= label_tag :password, t(:password) %>
        <%= password_field_tag :password, nil, autofocus: true, autocomplete: "off", required: true %>
      </div>
      <div class="actions">
        <%= submit_tag t("ui.share.unlock") %>
      </div>
    <% end %>
  </div>
</div>
