<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= theme_preference %>" data-scale="<%= scale_preference %>">
<head>
  <title><%= ["g0No", content_for(:title)].compact_blank.join(" - ") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <%= javascript_include_tag "application", defer: true %>
</head>
<body class="<%= content_for(:body_class) %>">
  <header class="menubar">
    <%= link_to "g0No", root_path, class: "menubar__brand" %>
    <% if user_signed_in? %>
      <nav class="menubar__nav">
        <%= link_to_unless_current(t("Content"), notes_path) { content_tag(:span, t("Content"), class: "current") } %>
        <% if current_user.admin? %>
          <%= link_to_unless_current(t("ui.admin.title"), admin_root_path) { content_tag(:span, t("ui.admin.title"), class: "current") } %>
        <% end %>
      </nav>
      <%= render "partials/search" %>
    <% end %>
    <div class="menubar__right">
      <%= render "partials/preferences" %>
      <% if user_signed_in? %>
        <span class="menubar__user"><%= current_user.display_name %></span>
        <%= button_to t("logout"), destroy_user_session_path, method: :delete, class: "menubar__button" %>
      <% end %>
    </div>
  </header>

  <main class="desk">
    <% if flash.any? %>
      <div class="flash-stack">
        <% flash.each do |type, message| %>
          <%= render "partials/flash", type: type, message: message %>
        <% end %>
      </div>
    <% end %>

    <% if devise_controller? %>
      <div class="sticky sticky--yellow auth">
        <div class="sticky__bar"><span class="sticky__caption">g0No</span></div>
        <div class="auth__body"><%= yield %></div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </main>
  <% if user_signed_in? %>
    <%= render "partials/confirm_dialog" %>
  <% end %>
</body>
</html>
