<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <title>g0No: <%= controller.action_name %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <%= javascript_include_tag "application", defer: true %>
</head>
<body>
  <div id="top-bar">
    <div id="nbar"></div>
    <div id="nuser">
      <% if user_signed_in? %>
        <%= button_to t("logout"), destroy_user_session_path, method: :delete %>
      <% end %>
    </div>
  </div>
  <div id="flash">
    <% flash.each do |type, message| %>
      <%= render "partials/flash", type: type, message: message %>
    <% end %>
  </div>
  <div id="container">
    <div class="upper-nav">
      <ul id="menu">
        <li><%= link_to_unless_current t("content"), notes_path %></li>
      </ul>
    </div>
    <div class="upper-nfo">
      <%= show_finance_total(@note) %>
      <%= show_add_remove_buttons?(controller) %>
    </div>
    <div style="clear: both;">
    <%= yield %>
    </div>
    <div style="display: block; clear: both; height: 3em;">
    </div>
  </div>
</body>
</html>
