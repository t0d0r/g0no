<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-theme="<%= theme_preference %>" data-scale="<%= scale_preference %>">
<head>
  <title><%= ["g0No", content_for(:title)].compact_blank.join(" - ") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%# Turbo Drive keeps no page snapshots: a back or forward visit always
      fetches the page, so an old copy of a note can never be shown (and then
      autosaved over newer text), and nothing stays cached after sign-out. %>
  <meta name="turbo-cache-control" content="no-cache">
  <%# A live refresh (live-updates.md) reloads the page where it is scrolled. %>
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "turbo.min", type: "module", "data-turbo-track": "reload" %>
  <%# data-turbo-eval=false: Turbo shows an error page (such as a revoked share
      link) by swapping the whole document, which would run this script a
      second time. %>
  <%= javascript_include_tag "application", defer: true, "data-turbo-track": "reload", "data-turbo-eval": "false" %>
</head>
<body class="<%= content_for(:body_class) %>">
  <header class="menubar">
    <%= link_to root_path, class: "menubar__brand", aria: { label: "g0No" } do %>
      <%= image_tag "/icon.svg", alt: "", width: 18, height: 18 %><span class="menubar__name">g0No</span>
    <% end %>
    <% if user_signed_in? %>
      <%# Sections as small pills, each marked with a paper colour square. %>
      <nav class="menubar__nav" aria-label="<%= t("ui.nav.label") %>">
        <%= link_to notes_path, class: "nav-link", aria: { current: ("page" if controller_name == "notes") } do %>
          <span class="nav-link__dot sticky--yellow" aria-hidden="true"></span><%= t("Content") %>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to admin_root_path, class: "nav-link", aria: { current: ("page" if controller_path.start_with?("admin/")) } do %>
            <span class="nav-link__dot sticky--gray" aria-hidden="true"></span><%= t("ui.admin.title") %>
          <% end %>
        <% end %>
      </nav>
    <% end %>
    <div class="menubar__right">
      <%= render "partials/preferences" %>
      <% if user_signed_in? %>
        <span class="menubar__user"><%= current_user.display_name %></span>
        <%= button_to t("logout"), destroy_user_session_path, method: :delete, class: "menubar__button" %>
      <% end %>
    </div>
  </header>

  <main class="desk">
    <% if flash.any? %>
      <div class="flash-stack">
        <% flash.each do |type, message| %>
          <%= render "partials/flash", type: type, message: message %>
        <% end %>
      </div>
    <% end %>

    <% if devise_controller? %>
      <div class="sticky sticky--yellow auth">
        <div class="sticky__bar"><span class="sticky__caption">g0No</span></div>
        <div class="auth__body"><%= yield %></div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </main>
  <% if user_signed_in? %>
    <%= render "partials/confirm_dialog" %>
  <% end %>
</body>
</html>
