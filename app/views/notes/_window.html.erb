<article class="sticky sticky--<%= sticky_color(note) %> note-window <%= "note-window--wide" if note.wide? %>" data-sticky>
  <header class="sticky__bar">
    <%= link_to "×", notes_path, class: "sticky__box", title: t("ui.back"), aria: { label: t("ui.back") } %>
    <% if note.persisted? %>
      <%= form_with model: note, class: "box-form" do %>
        <% label = note.markdown? ? t("ui.markdown.show_plain") : t("ui.markdown.show_formatted") %>
        <button type="submit" name="note[markdown]" value="<%= note.markdown? ? 0 : 1 %>"
                class="sticky__box sticky__box--icon markdown-box" aria-pressed="<%= note.markdown? %>"
                title="<%= label %>" aria-label="<%= label %>"><%= icon :markdown, size: 11 %></button>
      <% end %>
      <%# Wide note, like the zoom button of a window; application.js applies it
          at once and saves it in the background. %>
      <%= form_with model: note, class: "box-form wide-form", data: { wide_toggle: true,
                    wide_label: t("ui.wide.narrow"), narrow_label: t("ui.wide.widen") } do %>
        <% label = note.wide? ? t("ui.wide.narrow") : t("ui.wide.widen") %>
        <button type="submit" name="note[wide]" value="<%= note.wide? ? 0 : 1 %>"
                class="sticky__box sticky__box--icon wide-box" aria-pressed="<%= note.wide? %>"
                title="<%= label %>" aria-label="<%= label %>">
          <span class="wide-box__widen"><%= icon :widen, size: 10 %></span>
          <span class="wide-box__narrow"><%= icon :narrow, size: 10 %></span>
        </button>
      <% end %>
    <% end %>
    <span class="sticky__caption">
      <%= note.persisted? ? t("ui.edited", time: time_ago_in_words(note.updated_at)) : t("ui.new_note") %>
    </span>
    <%= render "color_menu", note: note %>
    <% if note.persisted? %>
      <%# Shown and driven by application.js; without JavaScript notes are never locked. %>
      <button type="button" class="sticky__box sticky__box--icon lock-box" hidden data-lock-box
              data-lock-label="<%= t("ui.lock.lock") %>" data-unlock-label="<%= t("ui.lock.unlock") %>">
        <span class="lock-box__locked"><%= icon :lock, size: 10 %></span>
        <span class="lock-box__unlocked"><%= icon :unlock, size: 10 %></span>
      </button>
    <% end %>
    <%= copy_note_box text_selector: "#note_description", title_selector: "#note_title" %>
    <% if note.persisted? %>
      <%= link_to history_note_path(note), class: "sticky__box sticky__box--icon",
                  title: t("ui.history.open"), aria: { label: t("ui.history.open") } do %>
        <%= icon :clock, size: 10 %>
      <% end %>
    <% end %>
    <% if note.persisted? %>
      <%= button_to "−", note_path(note), method: :delete, class: "sticky__box",
                    title: t("ui.delete_note"), aria: { label: t("ui.delete_note") },
                    form: { data: confirm_data(
                      title: t("ui.confirm.delete_note_title"),
                      body: t("ui.confirm.delete_note", title: note.title_was,
                              expenses: t("ui.confirm.expenses", count: note.finance_entries.count),
                              files: t("ui.files_count", count: note.note_attachments_count)),
                      button: t("ui.confirm.delete_note_button")) } %>
    <% else %>
      <span class="sticky__box sticky__box--spacer" aria-hidden="true"></span>
    <% end %>
  </header>
  <div class="note-window__body">
    <%= yield %>
  </div>
</article>
