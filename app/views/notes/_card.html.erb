<%= link_to note_path(note), class: "sticky sticky--#{sticky_color(note)} card",
            data: { card: true, id: note.id, created: note.created_at.to_f, updated: note.updated_at.to_f } do %>
  <span class="sticky__bar" aria-hidden="true"></span>
  <div class="card__body">
    <h2 class="card__title"><%= note.title %></h2>
    <p class="card__text"><%= truncate note_plain_text(note), length: 250, separator: " " %></p>
  </div>
  <div class="card__footer">
    <span class="card__meta"><%= t("ui.created_by", time: time_ago_in_words(note.created_at), author: note.author) %></span>
    <span class="card__badges">
      <% if note.note_attachments_count > 0 %>
        <span class="card__badge card__badge--files" title="<%= t("ui.files_count", count: note.note_attachments_count) %>">
          <%= icon :clip, label: t("ui.files_count", count: note.note_attachments_count) %><%= note.note_attachments_count %>
        </span>
      <% end %>
      <% if note.shared? %>
        <span class="card__badge card__badge--shared" title="<%= t("ui.share.shared") %>">
          <%= icon :link, label: t("ui.share.shared") %>
        </span>
      <% end %>
      <% if note.finance_total > 0 %>
        <span class="amount"><%= f_price note.finance_total %></span>
      <% end %>
    </span>
  </div>
<% end %>
