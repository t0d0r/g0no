<%= link_to note_path(note), class: "sticky sticky--#{sticky_color(note)} card" do %>
  <span class="sticky__bar" aria-hidden="true"></span>
  <div class="card__body">
    <h2 class="card__title"><%= note.title %></h2>
    <p class="card__text"><%= truncate note.description, length: 250, separator: " " %></p>
  </div>
  <div class="card__footer">
    <span class="card__meta"><%= t("ui.created_by", time: time_ago_in_words(note.created_at), author: note.author) %></span>
    <% if note.finance_total > 0 %>
      <span class="amount"><%= f_price note.finance_total %></span>
    <% end %>
  </div>
<% end %>
