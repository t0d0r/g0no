<% content_for :title, @tag %>
<div class="desk__header">
  <h1 class="desk__title"><%= t "Notes by tag" %>: <%= @tag %></h1>
  <%= render "board_tools", notes: @notes, sort: @sort, query: nil, color: nil %>
</div>

<div class="board">
  <%= render partial: "card", collection: @notes, as: :note %>
</div>
