<%# Saves itself (application.js): after a pause in typing, when a field loses
    focus, and when the page is left. The Save button is for browsers without JavaScript. %>
<%= form_with model: note, id: "note_form", class: "note-form",
              data: { note_form: true, saving: t("ui.autosave.saving"), saved: t("ui.autosave.saved"),
                      failed: t("ui.autosave.failed"), needs_title: t("ui.autosave.needs_title") } do |f| %>
  <% if note.errors.any? %>
    <div class="form-errors" role="alert">
      <ul>
        <% note.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="note-head">
    <%= f.label :title, t(:title), class: "sr-only" %>
    <%= f.text_field :title, class: "note-title", placeholder: t(:title).capitalize,
                     autocomplete: :off, autofocus: note.new_record? %>
    <% if note.persisted? && note.finance_total > 0 %>
      <div class="note-total">
        <span class="note-total__label"><%= t("expence") %></span>
        <span class="note-total__value"><%= f_price note.finance_total %></span>
      </div>
    <% end %>
  </div>
  <%= f.label :description, t(:description), class: "sr-only" %>
  <%= f.text_area :description, class: "note-description", rows: 4,
                  placeholder: t(:description).capitalize, autocomplete: :off, data: { autogrow: true } %>
  <div class="note-autosave">
    <span class="note-autosave__status" data-autosave-status role="status" aria-live="polite">
      <%= t("ui.autosave.hint") if note.new_record? %>
    </span>
    <noscript><%= f.submit t("ui.save"), class: "btn btn--primary" %></noscript>
  </div>
<% end %>
