<%= form_with model: @note, html: { class: "note" } do |f| %>
  <div style="clear: both;">
    <div class="label">
      <%= f.label :title, t(:title), class: :note_title %>
      <%= f.text_field :title, title: "заглавие", class: "blur", autocomplete: :off %>
    </div>
    <div class="label">
      <%= f.label :description, t(:description), class: :note_description %>
      <%= f.text_area :description, autocomplete: :off %>
    </div>
  </div>
  <div id="note_button_bar_container">
    <div id="note_button_bar" style="display: none">
      <%= f.submit "Запис", class: "button" %>
      <%= f.button "Отказ", type: "reset", id: "note_reset_button", class: "button" %>
    </div>
  </div>
<% end %>
