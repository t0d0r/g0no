<% content_for :title, t("Content") %>
<% filtered = @query.present? || @color %>
<div class="desk__header">
  <h1 class="desk__title">
    <% if filtered %>
      <%= t("ui.search.results") %><% if @query.present? %>: <%= @query %><% end %>
    <% else %>
      <%= t "Content" %>
    <% end %>
  </h1>
  <%= render "board_tools", notes: @notes, sort: @sort, query: @query, color: @color %>
</div>

<div class="board">
  <% unless filtered %>
    <%= link_to new_note_path, class: "card--new sticky" do %>
      <span class="card--new__plus" aria-hidden="true">+</span>
      <span><%= t("ui.new_note") %></span>
    <% end %>
  <% end %>
  <%= render partial: "card", collection: @notes, as: :note %>
  <% if @notes.empty? %>
    <p class="empty"><%= filtered ? t("ui.search.no_results") : t("ui.no_notes") %></p>
  <% end %>
</div>
