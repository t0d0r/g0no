<div class="form">
<%= render "form" %>
</div>

<% finance_entries = @note.finance_entries.select(&:persisted?) %>
<% unless finance_entries.empty? %>
  <table width="100%" cellspacing="0" cellpadding="0" class="table-finance">
    <%= render partial: "finance", collection: finance_entries %>
  </table>
<div class="empty_line"></div>
<% end %>
<div id="finance">
  <%= form_with model: @note do |f| %>
    <div id="add_finance">
        <div class="label finance_date">
          <%= label :finance, :date, t(:Date), class: :finance_date %>
          <%= date_field :finance, :date, value: Date.current %>
        </div>
        <div class="label finance_amount">
          <%= label :finance, :amount, t(:amount), class: :finance_amount %>
          <%= text_field :finance, :amount, size: 5, autocomplete: :off, inputmode: :decimal %>
        </div>
        <div class="label finance_comment">
          <%= label :finance, :comment, t(:comment), class: :finance_comment %>
          <%= text_field :finance, :comment, autocomplete: :off %>
        </div>
        <%= f.submit t("Add"), id: "submit_finance" %>
    </div>
  <% end %>
</div>
<div class="empty_line"></div>

<div class="add_bar" style="clear: both">
  <ul>
    <li><%= link_to "+ Добави приход/разход", "#", id: "finance_switch" %></li>
    <li><%= link_to "+ Добави файл", "#", id: "upload_file_switch" %></li>
  </ul>
</div>

<% attachments = @note.note_attachments.select(&:persisted?) %>
<% unless attachments.empty? %>
  <div style="width: 100%;">
    <table width="100%" cellspacing="0" cellpadding="0" class="table-files">
      <% attachments.each_with_index do |attachment, idx| %>
        <tr class="<%= odd_or_even(idx) %>">
          <td width="20%">
            <%= link_to_attachment @note, attachment %>
          </td>
          <td width="10%" align="right">
            <%= number_to_human_size(attachment.byte_size) %>
          </td>
          <td align="left" width="65%">
            <%= attachment.comment %>
          </td>
          <td align="right" width="5%">
            <%= button_to t("delete"), delete_file_note_path(@note, attachment_id: attachment), method: :delete,
                          form: { data: { confirm: t("Are You sure?") } } %>
          </td>
        </tr>
      <% end %>
    </table>
  </div>
  <div class="empty_line"></div>
<% end %>
<%= form_with model: @note, multipart: true do |f| %>
  <div id="upload_file_div">
    <div class="upload-filename">
      <%= file_field_tag "note[attachments][]", multiple: true, id: "note_attachments_" %>
    </div>
    <div class="label attachment">
      <%= label :note, :attachment_comment, t(:comment), class: :note_attachment_comment %>
      <%= text_field_tag "note[attachment_comment]", nil, autocomplete: :off %>
    </div>
    <%= f.submit t("Add"), id: "submit_attachment", class: :button %>
  </div>
<% end %>
