<%# The Stickies colour menu: a fixed set of paper colours, no custom ones. %>
<% current = sticky_color(note) %>
<% if note.persisted? %>
  <%= form_with model: note, class: "color-menu", aria: { label: t("ui.color") } do %>
    <% Note::COLORS.each do |color| %>
      <button type="submit" name="note[color]" value="<%= color %>"
              class="swatch sticky--<%= color %>" title="<%= t("ui.colors.#{color}") %>"
              aria-label="<%= t("ui.colors.#{color}") %>" aria-pressed="<%= color == current %>"></button>
    <% end %>
    <%# The random pick is chosen when the page is drawn, so it works without JavaScript. %>
    <button type="submit" name="note[color]" value="<%= (Note::COLORS - [ current ]).sample %>"
            class="swatch swatch--random" title="<%= t("ui.colors.random") %>" aria-label="<%= t("ui.colors.random") %>">
      <%= icon :dice, size: 11 %>
    </button>
  <% end %>
<% else %>
  <%# Inputs belong to the note form (form="note_form"), so the colour is saved with the new note. %>
  <span class="color-menu" role="radiogroup" aria-label="<%= t("ui.color") %>">
    <% Note::COLORS.each do |color| %>
      <label class="swatch sticky--<%= color %>" title="<%= t("ui.colors.#{color}") %>">
        <input type="radio" name="note[color]" value="<%= color %>" form="note_form" class="sr-only"
               <%= "checked" if color == current %> data-color-choice>
        <span class="sr-only"><%= t("ui.colors.#{color}") %></span>
      </label>
    <% end %>
    <button type="button" class="swatch swatch--random" data-color-random
            title="<%= t("ui.colors.random") %>" aria-label="<%= t("ui.colors.random") %>">
      <%= icon :dice, size: 11 %>
    </button>
  </span>
<% end %>
