<%# Search box with a colour filter. Searches title and description on the notes board. %>
<% selected_color = params[:color].presence_in(Note::COLORS) if controller_name == "notes" %>
<%= form_with url: notes_path, method: :get, class: "menubar__search", role: "search", data: { search_form: true } do %>
  <label class="search-field">
    <%= icon :search %>
    <span class="sr-only"><%= t("ui.search.label") %></span>
    <%= search_field_tag :q, (params[:q] if controller_name == "notes"), id: "menubar_q", class: "search-field__input",
                         placeholder: t("ui.search.placeholder"), autocomplete: "off", enterkeyhint: "search" %>
  </label>
  <details class="filter" data-filter>
    <summary class="filter__toggle <%= "filter__toggle--active" if selected_color %>"
             title="<%= t("ui.search.filter") %>" aria-label="<%= t("ui.search.filter") %>">
      <span class="filter__dot sticky--<%= selected_color || "all" %>" aria-hidden="true"></span>
    </summary>
    <fieldset class="filter__menu">
      <legend class="filter__legend"><%= t("ui.color") %></legend>
      <label class="filter__option">
        <input type="radio" name="color" value="" <%= "checked" unless selected_color %> data-filter-choice>
        <span class="filter__dot sticky--all" aria-hidden="true"></span><%= t("ui.colors.all") %>
      </label>
      <% Note::COLORS.each do |color| %>
        <label class="filter__option">
          <input type="radio" name="color" value="<%= color %>" <%= "checked" if color == selected_color %> data-filter-choice>
          <span class="filter__dot sticky--<%= color %>" aria-hidden="true"></span><%= t("ui.colors.#{color}") %>
        </label>
      <% end %>
      <noscript><button type="submit" class="btn"><%= t("ui.search.apply") %></button></noscript>
    </fieldset>
  </details>
<% end %>
