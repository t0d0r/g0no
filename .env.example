# Copy to .env (never commit .env). Used by compose.yaml.

# Required. Generate with: bin/rails secret
SECRET_KEY_BASE=

# Host used in links inside emails (password reset).
APP_HOST=localhost
MAILER_SENDER=no-reply@localhost

# First user, created on the first start when the database is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Only needed to keep passwords of users created by the 2011 app working.
# See specs/auth.md.
DEVISE_PEPPER=

# Only needed for a one-off import: make docker-import
# From inside the container, a CouchDB on the host is http://host.docker.internal:5984/<db>
COUCHDB_URL=

# Set both to true when a TLS-terminating proxy is in front of the app.
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false
